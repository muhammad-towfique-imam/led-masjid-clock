# Copy this file to .env (in this folder) and set the real value.
# .env is ignored by git. Never commit it.
#
# The passphrase that decrypts keystore-backup/release-key.enc for release builds.
# The real value is in Bitwarden: "HD Sender release key passphrase".
# At least 16 characters. Without it, the release APK is unsigned.
HDSENDER_KEY_PASSPHRASE=
