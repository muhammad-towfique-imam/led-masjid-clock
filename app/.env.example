# Copy this file to .env (in this folder) and set the real value.
# .env is ignored by git. Never commit it.
#
# The passphrase that decrypts keystore-backup/masjid-clock-key.enc for release builds.
# The real value is in Bitwarden: "Masjid Clock release key passphrase".
# At least 16 characters. Without it, the release APK is unsigned.
MASJIDCLOCK_KEY_PASSPHRASE=
